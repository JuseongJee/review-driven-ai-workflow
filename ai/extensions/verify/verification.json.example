{
  "verifiers": {
    "lighthouse": {
      "run": "npx lighthouse $URL --output=json --output-path=$OUTPUT_DIR/result.json",
      "criteria": [
        { "name": "performance", "description": "페이지 로딩 성능이 기준을 충족하는가", "weight": "high" },
        { "name": "accessibility", "description": "WCAG 2.1 AA 기준을 충족하는가", "weight": "high" }
      ],
      "evaluate": "위 criteria를 기준으로 각 항목을 1-5점으로 채점하고, 3점 미만인 항목의 구체적 개선사항을 제시하라.",
      "adapter": "ai/scripts/ai/verifiers/lighthouse.sh"
    },
    "playwright": {
      "run": "npx playwright test --reporter=json --output=$OUTPUT_DIR",
      "criteria": [
        { "name": "design-quality", "description": "색상, 타이포, 레이아웃, 이미지가 조화를 이루어 일관된 분위기와 아이덴티티를 만드는가", "weight": "high" },
        { "name": "craft", "description": "타이포 위계, 간격 일관성, 색상 조화, 대비 비율 등 기술적 완성도", "weight": "high" },
        { "name": "functionality", "description": "사용자가 인터페이스를 이해하고, 주요 동작을 찾고, 추측 없이 작업을 완료할 수 있는가", "weight": "high" }
      ],
      "evaluate": "위 criteria를 기준으로 각 항목을 1-5점으로 채점하고, 3점 미만인 항목의 구체적 개선사항을 제시하라.",
      "adapter": "ai/scripts/ai/verifiers/playwright.sh"
    }
  }
}